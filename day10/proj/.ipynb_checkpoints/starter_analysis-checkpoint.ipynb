import pandas as pd
import numpy as np

sales = pd.read_csv("sales.csv")
products = pd.read_csv("products.csv")
cities = pd.read_csv("cities.csv")
suppliers = pd.read_csv("suppliers.csv")

# Inspect the data
print(sales.head())
print(sales.tail())
print(sales.shape)
print(sales.size)
print(sales.columns)
sales.info()
print(sales.describe(include="all"))
print(sales.isnull().sum())       # Finds the intentional missing values
print(sales.duplicated().sum())   # Finds the intentional duplicate row

# Optional: handle missing values before calculations
sales["discount_pct"] = sales["discount_pct"].fillna(0)
sales["payment_method"] = sales["payment_method"].fillna("Unknown")

# Create columns
sales["gross_revenue"] = sales["quantity"] * sales["unit_price"]
sales["revenue"] = sales["gross_revenue"] * (1 - sales["discount_pct"] / 100)
print(sales["revenue"].describe())

# NumPy statistics
values = sales["revenue"].to_numpy()
print("Total revenue:", np.sum(values))
print("Average revenue:", np.mean(values))
print("Minimum revenue:", np.min(values))
print("Maximum revenue:", np.max(values))

# Revenue by product, city, and category
print(sales.groupby("product")["revenue"].sum().sort_values(ascending=False))
print(sales.groupby("city")["revenue"].sum().sort_values(ascending=False))
print(sales.groupby("category")["revenue"].sum().sort_values(ascending=False))

# Join the CSVs to enrich sales with product cost/supplier and city delivery details.
enriched = sales.merge(products[["product_id", "cost_price", "supplier_id"]],
                       on="product_id", how="left")
enriched = enriched.merge(cities[["city", "region", "delivery_fee", "delivery_days"]],
                          on="city", how="left")
enriched = enriched.merge(suppliers[["supplier_id", "supplier_name", "lead_time_days"]],
                          on="supplier_id", how="left")
enriched["estimated_cost"] = enriched["quantity"] * enriched["cost_price"]
enriched["estimated_profit"] = enriched["revenue"] - enriched["estimated_cost"]
print(enriched[["order_id", "product", "city", "revenue", "estimated_profit",
                "region", "supplier_name"]])
